# Variables de entorno de Neon.
# Los valores reales los genera `neon deploy` en .env.local (NO se sube a Git).
# Copia este archivo o usa neon deploy para obtener los valores.

# --- Postgres ---
DATABASE_URL=            # Conexión pooled: tráfico normal de la app
DATABASE_URL_UNPOOLED=   # Conexión directa: migraciones, dumps, replicación

# --- Branch de Neon ---
NEON_BRANCH=

# --- Neon Auth ---
NEON_AUTH_BASE_URL=
NEON_AUTH_JWKS_URL=
